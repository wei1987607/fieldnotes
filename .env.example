# FieldNotes — Firebase configuration
# Copy this file to `.env.local` and fill in the values from your Firebase
# project (Firebase console > Project settings > Your apps > Web app).
# `.env.local` is git-ignored — never commit real credentials.
# See README.md "Firebase setup" for the exact console steps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check — reCAPTCHA v3 site key (production).
# Get it from Firebase console > App Check > Apps > reCAPTCHA v3.
# Leave empty for local development: the App Check debug provider is used
# instead (see README.md).
VITE_APPCHECK_RECAPTCHA_SITE_KEY=

# App Check debug token (local development only, optional).
# Leave empty to auto-generate a token (printed in the browser console);
# register it in Console > App Check > Manage debug tokens.
# Set to a specific token string to reuse a registered one.
VITE_APPCHECK_DEBUG_TOKEN=
